PORT=5000
# IMPORTANT: In production, set NODE_ENV=production.
# Production strictly forbids demo role switching and weak/default secrets.
NODE_ENV=development
ENABLE_DEMO_ROLE_SWITCH=true
MONGODB_URI=mongodb://127.0.0.1:27017/udyam_one
# SECURITY: Minimum 32-character high-entropy secret required in production.
JWT_SECRET=development_only_secret_must_be_overridden_in_prod_min_32_chars!
JWT_EXPIRES_IN=24h
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATASET_REFERENCE_DATE=2026-07-15
ADDRESS_PROOF_MAX_AGE_DAYS=90
