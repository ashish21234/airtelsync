# Udyam One — Root Environment Configuration Example
# Copy to backend/.env and frontend/.env as needed

# Backend Server & Environment
PORT=5000
# IMPORTANT: Set NODE_ENV=production in production deployments.
# In production, demo role switching is strictly disabled and weak/default JWT secrets will halt startup.
NODE_ENV=development
ENABLE_DEMO_ROLE_SWITCH=true

# MongoDB Connection
MONGODB_URI=mongodb+srv://ashishranjan:ashishranjan21234@cluster0.ck4mxuw.mongodb.net

# JWT Authentication Secret
# SECURITY WARNING: In production (NODE_ENV=production), JWT_SECRET is MANDATORY and must be
# a cryptographically strong secret of AT LEAST 32 characters. Default/placeholder secrets will abort startup.
JWT_SECRET=development_only_secret_must_be_overridden_in_prod_min_32_chars!
JWT_EXPIRES_IN=24h

# Optional LLM / Vision API Key (Google Gemini)
# If omitted or empty, Udyam One uses its deterministic Catalogue-Grounded AI Advisor & Vision OCR engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Dataset Reference Date (Per Hackathon Specification: 15 July 2026)
DATASET_REFERENCE_DATE=2026-07-15
ADDRESS_PROOF_MAX_AGE_DAYS=90

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_ENABLE_DEMO_ROLE_SWITCH=true
